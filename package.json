{
  "name": "@cookiemunch/tauri",
  "version": "0.0.0",
  "description": "Cookie Munch Tauri SDK — webview consent manager, secure storage via the Tauri store plugin, and consent gating for Tauri desktop apps",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cookiemunch/sdk": "^0.1.0"
  },
  "peerDependencies": {
    "@tauri-apps/plugin-store": ">=2"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/plugin-store": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cookie-Munch/tauri.git"
  },
  "bugs": {
    "url": "https://github.com/Cookie-Munch/tauri/issues"
  },
  "homepage": "https://cookiemunch.net",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.6",
    "tsup": "^8.3",
    "vitest": "^2.1",
    "@types/node": "^22"
  }
}
